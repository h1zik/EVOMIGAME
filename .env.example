# Salin file ini menjadi .env lalu isi nilainya.
# Untuk lokal (npm run dev), semua boleh kosong. Untuk Docker, yang bertanda WAJIB harus diisi.

# WAJIB di Docker. Alamat game yang dilihat pengguna, tanpa garis miring di akhir.
# Contoh: https://versiku.evomi.id
# Kalau kosong (lokal), alamat diambil dari permintaan yang masuk.
BASE_URL=

# WAJIB di Docker. Kata sandi database PostgreSQL. Pakai huruf dan angka saja.
POSTGRES_PASSWORD=

# WAJIB di Docker. Garam untuk hash sidik perangkat. Isi dengan teks acak panjang,
# dan JANGAN diganti setelah game berjalan (kalau diganti, perangkat lama dianggap perangkat baru).
SIDIK_SALT=

# Kunci untuk membuka halaman /admin, minimal 8 karakter. Kalau kosong, /admin tidak aktif.
ADMIN_KEY=

# Hanya untuk lokal tanpa Docker: koneksi PostgreSQL. Kalau kosong, dipakai PGlite
# (PostgreSQL tertanam) di folder .data/pglite. Di Docker nilai ini diatur docker-compose.
DATABASE_URL=
